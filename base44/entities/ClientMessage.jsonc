{
  "name": "ClientMessage",
  "type": "object",
  "properties": {
    "client_request_id": {
      "type": "string"
    },
    "client_number": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "from_role": {
      "type": "string",
      "enum": [
        "client",
        "manager",
        "system"
      ],
      "enumColors": [
        "blue",
        "purple",
        "gray"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "message",
        "event"
      ],
      "enumColors": [
        "blue",
        "gray"
      ]
    },
    "is_internal": {
      "type": "boolean",
      "default": false
    },
    "is_clarification": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "client_request_id",
    "text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
