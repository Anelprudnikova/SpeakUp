{
  "name": "RoutingRule",
  "type": "object",
  "properties": {
    "category_id": {
      "type": "string"
    },
    "category_key": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "responsible_email": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "category_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
